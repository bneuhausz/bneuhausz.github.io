---
const apps = [
  { href: '/apps', label: 'All apps' },
  { href: '/apps/lift-recorder', label: 'Lift Recorder' },
  { href: '/apps/szokincs', label: 'SzóKincs' },
  { href: '/apps/magyar-kartya', label: 'Magyar kártya' },
  { href: '/apps/afa-kalkulator', label: 'ÁFA kalkulátor' },
  { href: '/apps/sorsveto', label: 'Sorsvető' },
  { href: '/apps/dobokocka', label: 'Hatos' },
  { href: '/apps/coin-flip', label: 'Coin Flip' },
];

const menuLink = 'text-amber-100 hover:bg-amber-100 hover:text-amber-900';
const navBtn = 'btn btn-ghost px-4 hover:bg-amber-100 hover:text-amber-900';
---

<nav class="navbar bg-neutral text-amber-100 gap-1 px-4 sm:gap-2 sm:px-8">
  <a href="/" class="shrink-0" aria-label="Home">
    <img src="/images/nb_logo_small.avif" alt="logo of the site" width="40" height="40" class="h-10 w-10" />
  </a>

  <div class="dropdown md:hidden">
    <div tabindex="0" role="button" aria-label="Open main menu" class="btn btn-square btn-ghost hover:bg-amber-100 hover:text-amber-900">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </div>
    <ul tabindex="0" class="dropdown-content menu mt-2 w-56 max-w-[calc(100vw-2rem)] rounded-box border border-amber-100/20 bg-neutral p-2 shadow-lg">
      <li>
        <a href="/blog" class={menuLink}>Blog</a>
      </li>
      <li>
        <a href="/about" class={menuLink}>About</a>
      </li>
      <li>
        <details>
          <summary class={menuLink}>Apps</summary>
          <ul class="border-l border-amber-100/20">
            {apps.map(({ href, label }) => (
              <li>
                <a href={href} class={menuLink}>{label}</a>
              </li>
            ))}
          </ul>
        </details>
      </li>
    </ul>
  </div>

  <div class="hidden md:flex md:items-center md:gap-2">
    <a class={navBtn} href="/blog">
      Blog
    </a>
    <a class={navBtn} href="/about">
      About
    </a>
    <div class="dropdown dropdown-hover">
      <a href="/apps" tabindex="0" class={navBtn}>
        Apps
      </a>
      <ul tabindex="0" class="dropdown-content menu w-56 max-w-[calc(100vw-2rem)] rounded-box border border-amber-100/20 bg-neutral p-2 shadow-lg">
        {apps.map(({ href, label }) => (
          <li>
            <a href={href} class={menuLink}>{label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <span class="flex-1"></span>

  <div class="flex shrink-0 items-center">
    <a href="https://github.com/bneuhausz" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile" class="flex h-10 w-10 items-center justify-center">
      <div class="w-5 h-5 bg-amber-100 github-icon"></div>
    </a>
    <a href="https://www.linkedin.com/in/b%C3%A1lint-neuhausz-61a4a4136" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile" class="flex h-10 w-10 items-center justify-center">
      <div class="w-5 h-5 bg-amber-100 linkedin-icon"></div>
    </a>
    <a href="mailto:contact@bneuhausz.dev" aria-label="Email" class="flex h-10 w-10 items-center justify-center">
      <span class="text-lg">@</span>
    </a>
  </div>
</nav>
