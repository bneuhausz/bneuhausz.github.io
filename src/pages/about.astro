---
import SiteLayout from "../layouts/SiteLayout.astro";
import { techStack } from "../data/tech-stack";

const description =
  "Bálint Neuhausz — senior software engineer in Pécs, Hungary, building enterprise and factory-floor software with Angular and ASP.NET Core.";

const experience = [
  {
    company: "IN2IT Business IT Solutions Kft.",
    period: "Oct 2020 - present",
    body: "Subcontractor in the team formed from the old T-Systems group, primarily working on enterprise systems for TRI (Telekom Rendszerintegráció Zrt.), the successor to T-Systems Magyarország.",
  },
  {
    company: "INNObyte Hungary",
    period: "Apr 2020 - Sep 2020",
    body: "A technical employer change caused by restructuring at T-Systems, but the practical day-to-day stayed the same: same team, same office, and the same work context.",
  },
  {
    company: "T-Systems Magyarország Zrt.",
    period: "2017 - Mar 2020",
    body: "Started my career here after university and worked on enterprise applications in a team focused on internal software, warehouse workflows, factory systems, and integrations.",
  },
];

const workAreas = [
  "Warehouse management systems and factory software used in production environments.",
  "PWAs for handheld devices and forklift terminals used on the factory floor.",
  "Internal business applications.",
  "Internet-facing business web apps and workflows.",
];

const selectedWork = [
  {
    title: "Warehouse management system",
    body: "A full warehouse management system for one of the country's largest beverage-distribution operations. It spans a management application for office staff and shift leaders, plus PWAs running on handheld scanners and forklift terminals for warehouse workers — all built in Angular — backed by an ASP.NET Core API and several .NET background services. I built the module that drives the warehouse's automated sorting line, communicating with its PLC over OPC UA, and worked across the background services handling scheduled jobs and client integrations.",
  },
  {
    title: "High-traffic public web applications",
    body: "Public-facing web applications used by thousands of people daily, built and maintained as part of a long-running enterprise service. Distributed caching with Redis keeps them responsive under that load.",
  },
  {
    title: "System integrations",
    body: "Integrations between enterprise systems in .NET: SAP, message-based exchange over AMQP, REST and SOAP APIs, and file-based (CSV) interfaces with third-party software.",
  },
];

const ldJson = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Bálint Neuhausz",
  jobTitle: "Senior Software Engineer",
  url: "https://bneuhausz.dev",
  image: "https://bneuhausz.dev/images/nb_face.jpg",
  email: "mailto:contact@bneuhausz.dev",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Pécs",
    addressCountry: "HU",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "University of Pécs",
  },
  worksFor: {
    "@type": "Organization",
    name: "IN2IT Business IT Solutions Kft.",
  },
  knowsAbout: techStack.map((tech) => tech.name),
  sameAs: [
    "https://github.com/bneuhausz",
    "https://www.linkedin.com/in/b%C3%A1lint-neuhausz-61a4a4136",
  ],
};
---

<SiteLayout
  title="About - bneuhausz.dev"
  description={description}
  canonical="https://bneuhausz.dev/about"
  ogImage="https://bneuhausz.dev/images/nb_face.jpg"
  ogImageAlt="Bálint Neuhausz"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(ldJson)}
  />

  <div class="mx-auto w-full max-w-5xl px-6 py-12 sm:py-16">
    <section
      class="flex flex-col gap-6 rounded-3xl border border-amber-100/20 bg-neutral-900/80 p-8 shadow-sm sm:p-10"
    >
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center">
        <img
          src="/images/nb_face.jpg"
          alt="Bálint Neuhausz"
          width="128"
          height="128"
          class="h-32 w-32 rounded-full border-4 border-amber-100/20 object-cover"
        />
        <div class="flex-1">
          <div
            class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
          >
            <div>
              <p class="text-sm uppercase tracking-[0.3em] text-amber-200/70">
                About me
              </p>
              <h1 class="text-4xl font-semibold text-amber-100">
                Bálint Neuhausz
              </h1>
              <p class="mt-1 text-base text-amber-200/70">
                Senior Software Engineer
              </p>
            </div>
            <div class="flex items-center gap-3">
              <a
                href="https://github.com/bneuhausz"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub profile"
                class="btn btn-square btn-ghost border border-amber-100/20 hover:border-amber-100 hover:bg-amber-100 hover:text-amber-900"
              >
                <span class="github-icon h-5 w-5 bg-current"></span>
              </a>
              <a
                href="https://www.linkedin.com/in/b%C3%A1lint-neuhausz-61a4a4136"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn profile"
                class="btn btn-square btn-ghost border border-amber-100/20 hover:border-amber-100 hover:bg-amber-100 hover:text-amber-900"
              >
                <span class="linkedin-icon h-5 w-5 bg-current"></span>
              </a>
              <a
                href="mailto:contact@bneuhausz.dev"
                aria-label="Send an email"
                class="btn btn-square btn-ghost border border-amber-100/20 text-lg hover:border-amber-100 hover:bg-amber-100 hover:text-amber-900"
              >
                @
              </a>
            </div>
          </div>

          <p class="mt-4 max-w-4xl text-base leading-7 text-amber-50/90">
            Senior software engineer based in Pécs, Hungary, working with the
            same team since 2017. The company on my contract has changed a few
            times, but the work has stayed continuous: enterprise software,
            frontend modernization, and system integrations for industrial and
            business workflows.
          </p>
          <p class="mt-3 max-w-4xl text-base leading-7 text-amber-50/90">
            I started as a junior and have owned technical and architecture
            decisions for most of my time here. These days I also mentor the
            developers joining the team.
          </p>
        </div>
      </div>
    </section>

    <section class="mt-8 grid gap-6 lg:grid-cols-[1.25fr_0.9fr]">
      <article
        class="rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-8 shadow-sm"
      >
        <h2 class="text-2xl font-semibold text-amber-100">Experience</h2>
        <div class="mt-6 space-y-5">
          {
            experience.map((job) => (
              <div class="rounded-2xl border border-amber-100/15 bg-neutral-800/60 p-5">
                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                  <h3 class="text-xl font-medium text-amber-100">
                    {job.company}
                  </h3>
                  <span class="text-sm text-amber-200/70">{job.period}</span>
                </div>
                <p class="mt-3 text-amber-50/90">{job.body}</p>
              </div>
            ))
          }
        </div>
      </article>

      <aside class="space-y-6">
        <section
          class="rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-8 shadow-sm"
        >
          <h2 class="text-2xl font-semibold text-amber-100">Education</h2>
          <div
            class="mt-4 rounded-2xl border border-amber-100/15 bg-neutral-800/60 p-5"
          >
            <h3 class="text-xl font-medium text-amber-100">
              BSc in Computer Science Engineering
            </h3>
            <p class="mt-1 text-amber-200/70">University of Pécs, 2017</p>
          </div>
        </section>

        <section
          class="rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-8 shadow-sm"
        >
          <h2 class="text-2xl font-semibold text-amber-100">What I work on</h2>
          <ul class="mt-4 space-y-3 text-amber-50/90">
            {workAreas.map((area) => <li>{area}</li>)}
          </ul>
        </section>
      </aside>
    </section>

    <section
      class="mt-8 rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-8 shadow-sm"
    >
      <h2 class="text-2xl font-semibold text-amber-100">Selected work</h2>
      <div class="mt-6 space-y-5">
        {
          selectedWork.map((project) => (
            <div class="rounded-2xl border border-amber-100/15 bg-neutral-800/60 p-5">
              <h3 class="text-xl font-medium text-amber-100">
                {project.title}
              </h3>
              <p class="mt-3 text-amber-50/90">{project.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section
      class="mt-8 rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-8 shadow-sm"
    >
      <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:gap-8">
        <div class="min-w-0 flex-1">
          <h2 class="text-2xl font-semibold text-amber-100">Stack and focus</h2>
          <p class="mt-2 max-w-3xl text-amber-50/90">
            I led the adoption of Angular across our frontend applications, and
            frontend modernization has been a recurring theme in my work since.
          </p>
          <p class="mt-2 max-w-3xl text-amber-50/90">
            Day to day I work full-stack: ASP.NET Core on the backend and
            Angular on the frontend, with occasional Node.js scripts and .NET
            background services in the mix, backed by PostgreSQL or SQL Server
            depending on the project.
          </p>
          <p class="mt-2 max-w-3xl text-amber-50/90">
            Lately I've been learning and evaluating Flutter, as the need for
            native mobile functionality comes up more and more.
          </p>
        </div>

        <div
          class="flex flex-wrap gap-2 lg:w-[22rem] lg:flex-none lg:justify-start"
        >
          {
            techStack.map((tech) => (
              <span
                class={`rounded-full border border-amber-100/20 bg-amber-100/10 px-3 py-1 text-sm text-amber-100${tech.secondary ? " opacity-70" : ""}`}
              >
                {tech.name}
              </span>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
