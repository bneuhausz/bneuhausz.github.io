---
import SiteLayout from "../../../layouts/SiteLayout.astro";

const lastUpdated = "July 21, 2026";
---

<SiteLayout
  title="Lift Recorder Terms of Use - bneuhausz.dev"
  description="Terms of use for the Lift Recorder Android app."
  canonical="https://bneuhausz.dev/apps/lift-recorder/terms"
>
  <section
    class="prose dark:prose-invert text-left max-w-screen-md mx-auto px-8 pb-16"
  >
    <p class="text-sm text-amber-200/70">
      <a href="/apps/lift-recorder">← Back to Lift Recorder</a>
    </p>

    <h1 class="text-3xl">Lift Recorder — Terms of Use</h1>
    <p class="text-sm text-amber-200/70">Last updated: {lastUpdated}</p>

    <p>
      These terms are the agreement between you and Bálint Neuhausz (Hungary)
      ("we", "us") for your use of the <strong>Lift Recorder</strong> Android app
      (the "App"). By installing or using the App you agree to them; if you do not
      agree, do not use the App. Business details are in the <a href="/imprint"
        >Imprint</a
      >.
    </p>

    <h2 class="text-2xl">1. Licence</h2>
    <p>
