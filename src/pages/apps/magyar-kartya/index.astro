---
import SiteLayout from "../../../layouts/SiteLayout.astro";

const pageUrl = "https://bneuhausz.dev/apps/magyar-kartya";
const logoUrl = "https://bneuhausz.dev/images/magyar-kartya-logo.png";
const ogImageUrl = "https://bneuhausz.dev/images/magyar-kartya-og.png";
const description =
  "A free offline Hungarian card-game app: zsírozás, snapszer and makaó against bots at three difficulty levels, on a Hungarian (Tell-pattern) deck drawn from scratch. No account, no internet needed, everything on-device.";

const features = [
  {
    title: "Three Hungarian classics",
    body: "Zsírozás, snapszer (the classic 66) and makaó — three different kinds of game on the same 32-card deck: two trick-takers and one shedding game. Each has its own rules page in the app, so the house rules are never a guess.",
  },
  {
    title: "Bots that actually play",
    body: "Three difficulty levels — könnyű, közepes and nehéz. The stronger levels search rather than follow a checklist, and each one was measured over thousands of hands against the level below it before it shipped.",
  },
  {
    title: "A deck drawn from scratch",
    body: "The Hungarian (Tell-pattern) deck is original vector artwork made for this app, not a scan — so it is drawn for a phone screen: the corner index stays readable even when you are holding a fan of sixteen cards.",
  },
  {
    title: "Card sets and tables to collect",
    body: "Play on the free deck and green felt for as long as you like, or dress the table up: five extra card sets and eight extra tables, five of which are gently animated. They change how the game looks, never how it plays.",
  },
  {
    title: "Offline, with no account",
    body: "There is no registration, no login and no cloud. Matches, per-difficulty statistics and 33 achievements live on your phone, and the whole app works in airplane mode.",
  },
];

const faqs = [
  {
    question: "Which games can I play?",
    answer:
      "Three: zsírozás, snapszer (66) and makaó, each against a bot at your choice of three difficulty levels. Where the traditional rules differ from region to region, the app picks one variant and documents it on the game's rules page.",
  },
  {
    question: "Is Magyar kártya free?",
    answer:
      "Yes. The game is free and shows ads: a banner, plus a full-screen ad between hands. A one-time in-app purchase removes both permanently. The extra card sets and tables are separate optional purchases that only change the app's looks.",
  },
  {
    question: "Do I need an internet connection to play?",
    answer:
      "No. The games, the bots, your statistics and your achievements all run on your phone — you can play in airplane mode. A connection is only used to serve ads and to send crash reports.",
  },
  {
    question: "Can I play against other people?",
    answer:
      "Not today. The app is a solo game against the bots, with no accounts, no lobbies and no online play — that is what lets it work completely offline.",
  },
  {
    question: "Is there in-game currency or a loot box?",
    answer:
      "No. There is no in-game currency, no gacha and no randomised purchase. Everything for sale is a named cosmetic you can look at in full before buying, and nothing you can buy affects the cards you are dealt or how the bots play.",
  },
  {
    question: "What language is the game in?",
    answer:
      "Hungarian only. The card names, the suits and the game terminology are Hungarian by nature, so the whole interface follows them.",
  },
  {
    question: "What data does the game collect?",
    answer:
      "The game itself collects none — no account, no analytics, nothing uploaded. Two things leave your device: crash reports, and the data Google needs to serve ads (with a consent prompt in the EEA). The privacy policy has the full details.",
  },
  {
    question: "What platforms is it on?",
    answer:
      "Magyar kártya is an Android game, coming soon to Google Play. Other platforms may follow later.",
  },
];

const ldJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MobileApplication",
      name: "Magyar kártya",
      operatingSystem: "Android",
      applicationCategory: "GameApplication",
      inLanguage: "hu",
      description,
      url: pageUrl,
      image: logoUrl,
      author: {
        "@type": "Person",
        name: "Bálint Neuhausz",
        url: "https://bneuhausz.dev",
      },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://bneuhausz.dev",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Apps",
          item: "https://bneuhausz.dev/apps",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Magyar kártya",
          item: pageUrl,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
  ],
};

const featureGraphic = {
  src: "/images/magyar-kartya/feature-graphic.png",
  alt: "Magyar kártya feature graphic — the four suit signs and a fan of Tell-krónika aces on felt",
};

const screenshots = [
  {
    src: "/images/magyar-kartya/screenshot-1.png",
    alt: "A makaó hand with the MAKAÓ button armed",
    caption: "Makaó",
    width: 540,
    height: 960,
  },
  {
    src: "/images/magyar-kartya/screenshot-2.png",
    alt: "Zsírozás mid-trick",
    caption: "Zsírozás",
    width: 540,
    height: 960,
  },
  {
    src: "/images/magyar-kartya/screenshot-3.png",
    alt: "Snapszer with the meld and exchange actions",
    caption: "Snapszer",
    width: 540,
    height: 960,
  },
  {
    src: "/images/magyar-kartya/screenshot-4.png",
    alt: "The Tell-krónika card set preview",
    caption: "Tell-krónika card set",
    width: 540,
    height: 960,
  },
];
---

<SiteLayout
  title="Magyar kártya - Hungarian Card Games for Android"
  description={description}
  canonical={pageUrl}
  ogImage={ogImageUrl}
  ogImageAlt="Magyar kártya — zsírozás, snapszer and makaó on a Hungarian deck"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(ldJson)}
  />

  <div class="mx-auto w-full max-w-5xl px-6 py-12 sm:py-16">
    <section class="flex flex-col items-center gap-6 text-center">
      <img
        src="/images/magyar-kartya-logo.png"
        alt="Magyar kártya app icon"
        width="80"
        height="80"
        class="h-20 w-20 rounded-3xl border border-amber-100/20 shadow-sm"
      />

      <div class="flex flex-col gap-2">
        <p class="text-sm uppercase tracking-[0.3em] text-amber-200/70">
          Android app
        </p>
        <h1 class="text-4xl font-semibold sm:text-5xl">Magyar kártya</h1>
        <p class="text-lg text-amber-200/80">
          Zsírozás, snapszer and makaó — offline, against the machine.
        </p>
      </div>

      <p class="max-w-2xl text-base leading-7 text-amber-50/90">
        Three Hungarian card games on one <strong>hand-drawn Tell-pattern
        deck</strong>, played solo against bots at three difficulty levels.
        Statistics, 33 achievements, and card sets and tables to collect — all
        fully offline with <strong>no account</strong> and nothing uploaded.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-amber-100/20 bg-amber-100/10 px-4 py-2 text-sm text-amber-100"
        >
          <span
            class="inline-block h-2 w-2 rounded-full bg-amber-200"
            aria-hidden="true"></span>
          Coming soon to Google Play
        </span>
      </div>

      <div
        class="mt-2 flex flex-wrap items-center justify-center gap-4 text-sm text-amber-200"
      >
        <a
          href="/apps/magyar-kartya/privacy"
          class="underline-offset-4 hover:underline"
        >
          Privacy Policy
        </a>
        <span aria-hidden="true" class="text-amber-100/30">•</span>
        <a
          href="/apps/magyar-kartya/terms"
          class="underline-offset-4 hover:underline"
        >
          Terms of Use
        </a>
      </div>
    </section>

    <section class="mt-12">
      <img
        src={featureGraphic.src}
        alt={featureGraphic.alt}
        width="1024"
        height="500"
        loading="lazy"
        class="mx-auto w-full max-w-3xl rounded-3xl border border-amber-100/20 shadow-sm"
      />
    </section>

    <section class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        features.map((feature) => (
          <article class="flex h-full flex-col rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-7 shadow-sm">
            <h2 class="text-xl font-semibold text-amber-100">
              {feature.title}
            </h2>
            <p class="mt-3 flex-grow text-amber-50/80">{feature.body}</p>
          </article>
        ))
      }
    </section>

    <section
      class="mt-8 rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-8 shadow-sm sm:p-10"
    >
      <h2 class="text-2xl font-semibold text-amber-100">Screenshots</h2>
      <div
        class="mt-6 flex snap-x gap-4 overflow-x-auto pb-2 sm:grid sm:grid-cols-4 sm:overflow-visible sm:pb-0"
      >
        {
          screenshots.map((shot) => (
            <figure class="w-48 shrink-0 snap-start sm:w-auto">
              <img
                src={shot.src}
                alt={shot.alt}
                width={shot.width}
                height={shot.height}
                loading="lazy"
                class="w-full rounded-2xl border border-amber-100/20 shadow-sm"
              />
              <figcaption class="mt-3 text-center text-sm text-amber-200/70">
                {shot.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section
      class="mt-8 rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-8 shadow-sm sm:p-10"
    >
      <h2 class="text-2xl font-semibold text-amber-100">The three games</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        <div>
          <h3 class="text-lg font-semibold text-amber-100">Zsírozás</h3>
          <p class="mt-2 text-base leading-7 text-amber-50/90">
            Suits and card order don't matter here: you take a trick by matching
            the rank that was led — or by dropping a seven, which beats
            anything. The aces and tens are the <em>zsír</em> — the "fat" the
            game is named after — 10 points each, 80 in the deck, and a match
            runs to five game points.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-amber-100">Snapszer</h3>
          <p class="mt-2 text-base leading-7 text-amber-50/90">
            The classic 66, with everything the game is known for: trump
            exchange, closing the talon, melding twenty and forty, and a strict
            second phase where you must follow suit and beat the lead.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-amber-100">Makaó</h3>
          <p class="mt-2 text-base leading-7 text-amber-50/90">
            The shedding game: follow the top card's suit or rank and run your
            hand down to nothing. Sevens chain and stack the draw penalty, an
            ace skips a turn, a felső goes on anything and calls a suit, an alsó
            calls a rank — and you must say „makaó" as you play your
            second-to-last card, or draw four for the silence.
          </p>
        </div>
      </div>
    </section>

    <section
      class="mt-8 rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-8 shadow-sm sm:p-10"
    >
      <h2 class="text-2xl font-semibold text-amber-100">Why it exists</h2>
      <p class="mt-4 max-w-3xl text-base leading-7 text-amber-50/90">
        Hungarian card games are easy to learn and hard to find well made on a
        phone: the apps that exist tend to want an account, a connection, or
        your patience. This one wants none of them — it deals, the bot thinks,
        and that is the whole loop, in your pocket and in Hungarian.
      </p>
      <p class="mt-4 max-w-3xl text-base leading-7 text-amber-50/90">
        The deck was drawn from scratch for the same reason. The Tell pattern
        Hungarians grew up with is centuries old and long out of copyright, but
        modern scans of it are not, so every card here is original vector
        artwork in that tradition — which is also what makes the extra card
        sets possible, from an embroidered Kalocsai deck to a neon one and a
        deck set in space.
      </p>
    </section>

    <section
      class="mt-8 rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-8 shadow-sm sm:p-10"
    >
      <h2 class="text-2xl font-semibold text-amber-100">
        Free, with optional upgrades
      </h2>
      <p class="mt-4 max-w-3xl text-base leading-7 text-amber-50/90">
        The game is free and shows ads served by Google AdMob — a banner, plus a
        full-screen ad between hands — with a consent prompt where the GDPR
        requires one. A one-time in-app purchase removes them permanently. The
        extra card sets and tables are separate one-time purchases and are
        purely cosmetic: there is no in-game currency, nothing randomised, and
        nothing you can buy changes the cards you are dealt. Everything the game
        does and doesn't collect is spelled out in the
        <a
          href="/apps/magyar-kartya/privacy"
          class="text-amber-100 underline underline-offset-4 hover:text-amber-200"
          >Privacy Policy</a
        >.
      </p>
    </section>

    <section
      class="mt-8 rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-8 shadow-sm sm:p-10"
    >
      <h2 class="text-2xl font-semibold text-amber-100">
        Frequently asked questions
      </h2>
      <div class="mt-6 flex flex-col gap-6">
        {
          faqs.map((faq) => (
            <div>
              <h3 class="text-lg font-semibold text-amber-100">
                {faq.question}
              </h3>
              <p class="mt-2 max-w-3xl text-base leading-7 text-amber-50/90">
                {faq.answer}
              </p>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</SiteLayout>
