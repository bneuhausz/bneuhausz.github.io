---
import SiteLayout from "../../../layouts/SiteLayout.astro";

const pageUrl = "https://bneuhausz.dev/apps/szokincs";
const logoUrl = "https://bneuhausz.dev/images/szokincs-logo.png";
const ogImageUrl = "https://bneuhausz.dev/images/szokincs-og.png";
const description =
  "A free offline word-search game in Hungarian: grids built for the Hungarian alphabet where SZ, GY or DZS fit a single square, ten themed campaigns, a daily puzzle, streaks and achievements. No account, everything on-device.";

const features = [
  {
    title: "Built for the Hungarian alphabet",
    body: "One square holds one Hungarian letter — so CS, GY, SZ and even DZS each sit in a single cell, exactly the way you spell. SZÉKESFEHÉRVÁR is fourteen characters, but on the board it is thirteen squares.",
  },
  {
    title: "Ten themed campaigns",
    body: "300 hand-checked levels across ten themes, from Hungarian cities and animals to food, sport, music and history. Two themes are free from the start; the rest unlock with the gold you earn by playing — no purchase needed.",
  },
  {
    title: "A puzzle every day",
    body: "A free daily puzzle everyone gets in the same form, a daily streak with an optional evening reminder, and a streak shield you can earn to protect a run you care about.",
  },
  {
    title: "Progress worth keeping",
    body: "Earn gold and XP, climb a ten-rank ladder, chase 17 achievements and three fresh daily missions, and spend your winnings on board colors and backgrounds in the in-game shop — all with earned gold, never real money.",
  },
  {
    title: "Offline, with no account",
    body: "There is no registration, no login and no cloud. The whole game runs on your phone, your progress is saved on your device, and you can play in airplane mode.",
  },
];

const faqs = [
  {
    question: "Is SzóKincs free?",
    answer:
      "Yes. The game is free and shows ads. A one-time in-app purchase removes the banner and full-screen ads permanently; rewarded videos remain available afterwards, but only ever play when you choose to watch one for a hint.",
  },
  {
    question: "Do I need an internet connection to play?",
    answer:
      "No. The puzzles, your progress and everything else work fully offline — you can play in airplane mode. A connection is only used to serve ads and to send crash reports.",
  },
  {
    question: "What language is the game in?",
    answer:
      "Hungarian only, and that is the point: the grid understands the Hungarian alphabet, so digraphs like SZ or GY and the trigraph DZS each occupy a single square instead of being split into letters.",
  },
  {
    question: "Do I need an account?",
    answer:
      "No. There is no sign-up, login or profile. Your progress, gold and settings are stored in a single file on your device and are deleted with the app.",
  },
  {
    question: "What data does the game collect?",
    answer:
      "The game itself collects none — no account, no analytics, nothing uploaded. Two things leave your device: crash reports, and the data Google needs to serve ads (with a consent prompt in the EEA). The privacy policy has the full details.",
  },
  {
    question: "What platforms is it on?",
    answer:
      "SzóKincs is an Android game, coming soon to Google Play. Other platforms may follow later.",
  },
];

const ldJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MobileApplication",
      name: "SzóKincs",
      operatingSystem: "Android",
      applicationCategory: "GameApplication",
      inLanguage: "hu",
      description,
      url: pageUrl,
      image: logoUrl,
      author: {
        "@type": "Person",
        name: "Bálint Neuhausz",
        url: "https://bneuhausz.dev",
      },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://bneuhausz.dev",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Apps",
          item: "https://bneuhausz.dev/apps",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "SzóKincs",
          item: pageUrl,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<SiteLayout
  title="SzóKincs - Hungarian Word-Search Game for Android"
  description={description}
  canonical={pageUrl}
  ogImage={ogImageUrl}
  ogImageAlt="SzóKincs — a word-search game built for the Hungarian alphabet"
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(ldJson)}
  />

  <div class="mx-auto w-full max-w-5xl px-6 py-12 sm:py-16">
    <section class="flex flex-col items-center gap-6 text-center">
      <img
        src="/images/szokincs-logo.png"
        alt="SzóKincs app icon"
        width="80"
        height="80"
        class="h-20 w-20 rounded-3xl border border-amber-100/20 shadow-sm"
      />

      <div class="flex flex-col gap-2">
        <p class="text-sm uppercase tracking-[0.3em] text-amber-200/70">
          Android app
        </p>
        <h1 class="text-4xl font-semibold sm:text-5xl">SzóKincs</h1>
        <p class="text-lg text-amber-200/80">
          A word-search game built for the Hungarian alphabet.
        </p>
      </div>

      <p class="max-w-2xl text-base leading-7 text-amber-50/90">
        Drag across the grid to find hidden Hungarian words — in boards that
        treat <strong>SZ, GY or DZS as one square</strong>, the way Hungarian is
        actually spelled. Ten themed campaigns, a free daily puzzle, streaks,
        achievements and an in-game shop, all fully offline with
        <strong>no account</strong> and nothing uploaded.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-amber-100/20 bg-amber-100/10 px-4 py-2 text-sm text-amber-100"
        >
          <span
            class="inline-block h-2 w-2 rounded-full bg-amber-200"
            aria-hidden="true"></span>
          Coming soon to Google Play
        </span>
      </div>

      <div
        class="mt-2 flex flex-wrap items-center justify-center gap-4 text-sm text-amber-200"
      >
        <a
          href="/apps/szokincs/privacy"
          class="underline-offset-4 hover:underline"
        >
          Privacy Policy
        </a>
        <span aria-hidden="true" class="text-amber-100/30">•</span>
        <a
          href="/apps/szokincs/terms"
          class="underline-offset-4 hover:underline"
        >
          Terms of Use
        </a>
      </div>
    </section>

    <section class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        features.map((feature) => (
          <article class="flex h-full flex-col rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-7 shadow-sm">
            <h2 class="text-xl font-semibold text-amber-100">
              {feature.title}
            </h2>
            <p class="mt-3 flex-grow text-amber-50/80">{feature.body}</p>
          </article>
        ))
      }
    </section>

    <section
      class="mt-8 rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-8 shadow-sm sm:p-10"
    >
      <h2 class="text-2xl font-semibold text-amber-100">Why it exists</h2>
      <p class="mt-4 max-w-3xl text-base leading-7 text-amber-50/90">
        Word-search games treat every language like English: one letter, one
        square. Hungarian doesn't work that way — CS, GY, LY, NY, SZ, TY, ZS
        and DZS are single letters of the alphabet that happen to be written
        with two or three characters. SzóKincs puts each of them in a single
        cell, so words read the way a Hungarian speaker actually spells them,
        and finding <em>VISSZA</em> means finding V-I-SZ-SZ-A. It is a small
        detail that changes the whole feel of the puzzle.
      </p>
    </section>

    <section
      class="mt-8 rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-8 shadow-sm sm:p-10"
    >
      <h2 class="text-2xl font-semibold text-amber-100">
        Free, with an optional upgrade
      </h2>
      <p class="mt-4 max-w-3xl text-base leading-7 text-amber-50/90">
        The game is free and shows ads served by Google AdMob, with a consent
        prompt where the GDPR requires one. A one-time in-app purchase removes
        the banner and full-screen ads permanently — rewarded videos stay
        available for hints, but only ever play at your request. Everything the
        game does and doesn't collect is spelled out in the
        <a
          href="/apps/szokincs/privacy"
          class="text-amber-100 underline underline-offset-4 hover:text-amber-200"
          >Privacy Policy</a
        >.
      </p>
    </section>

    <section
      class="mt-8 rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-8 shadow-sm sm:p-10"
    >
      <h2 class="text-2xl font-semibold text-amber-100">
        Frequently asked questions
      </h2>
      <div class="mt-6 flex flex-col gap-6">
        {
          faqs.map((faq) => (
            <div>
              <h3 class="text-lg font-semibold text-amber-100">
                {faq.question}
              </h3>
              <p class="mt-2 max-w-3xl text-base leading-7 text-amber-50/90">
                {faq.answer}
              </p>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</SiteLayout>
