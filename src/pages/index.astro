---
import SiteLayout from '../layouts/SiteLayout.astro';

const techStack = [
  { name: 'Angular' },
  { name: 'ASP.NET Core' },
  { name: 'Node.js' },
  { name: 'PostgreSQL' },
  { name: 'SQL Server' },
  { name: 'Flutter', secondary: true },
  { name: 'Redis', secondary: true },
  { name: 'OPC UA', secondary: true },
  { name: 'SAP', secondary: true },
  { name: 'AMQP', secondary: true },
];

const cards = [
  {
    title: 'Blog',
    description: 'Technical notes and tutorials on the things I build.',
    href: '/blog',
    cta: 'Read posts',
    external: false,
  },
  {
    title: 'About me',
    description: 'Background, experience, and the stack I work with.',
    href: '/about',
    cta: 'Learn more',
    external: false,
  },
  {
    title: 'Apps',
    description: 'Small Android apps I build on the side.',
    href: '/apps',
    cta: 'Browse apps',
    external: false,
  },
  {
    title: 'GitHub',
    description: 'Source code for my posts and personal projects.',
    href: 'https://github.com/bneuhausz',
    cta: 'View profile',
    external: true,
  },
];
---

<SiteLayout title="bneuhausz.dev" description="Personal blog and notes by Bálint Neuhausz" canonical="https://bneuhausz.dev/">
  <div class="mx-auto w-full max-w-5xl px-6 py-12 sm:py-16">
    <section class="flex flex-col items-center gap-6 text-center">
      <img
        src="/images/nb_face.jpg"
        alt="Bálint Neuhausz"
        class="h-28 w-28 rounded-full border-4 border-amber-100/20 object-cover shadow-sm"
      />

      <div class="flex flex-col gap-2">
        <p class="text-sm uppercase tracking-[0.3em] text-amber-200/70">bneuhausz.dev</p>
        <h1 class="text-4xl font-semibold sm:text-5xl">Bálint Neuhausz</h1>
        <p class="text-lg text-amber-200/80">Senior Software Engineer · Pécs, Hungary</p>
      </div>

      <p class="max-w-2xl text-base leading-7 text-amber-50/90">
        Full-stack dev working with Angular and ASP.NET Core. I build enterprise and
        factory-floor software, and write about the things I learn along the way.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="/blog" class="btn border-none bg-amber-100 text-amber-900 hover:bg-amber-200">
          Read the blog
        </a>
        <a
          href="https://github.com/bneuhausz"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          class="btn btn-square btn-ghost border border-amber-100/20 hover:border-amber-100 hover:bg-amber-100 hover:text-amber-900"
        >
          <span class="github-icon h-5 w-5 bg-current"></span>
        </a>
        <a
          href="https://www.linkedin.com/in/b%C3%A1lint-neuhausz-61a4a4136"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile"
          class="btn btn-square btn-ghost border border-amber-100/20 hover:border-amber-100 hover:bg-amber-100 hover:text-amber-900"
        >
          <span class="linkedin-icon h-5 w-5 bg-current"></span>
        </a>
        <a
          href="mailto:contact@bneuhausz.dev"
          aria-label="Send an email"
          class="btn btn-square btn-ghost border border-amber-100/20 text-lg hover:border-amber-100 hover:bg-amber-100 hover:text-amber-900"
        >
          @
        </a>
      </div>

      <div class="mt-2 flex flex-wrap justify-center gap-2">
        {techStack.map((tech) => (
          <span class={`rounded-full border border-amber-100/20 bg-amber-100/10 px-3 py-1 text-sm text-amber-100${tech.secondary ? ' opacity-70' : ''}`}>
            {tech.name}
          </span>
        ))}
      </div>
    </section>

    <section class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((card) => (
        <a
          href={card.href}
          target={card.external ? '_blank' : undefined}
          rel={card.external ? 'noopener noreferrer' : undefined}
          class="flex h-full flex-col rounded-3xl border border-amber-100/20 bg-neutral-900/70 p-7 shadow-sm transition-shadow duration-500 hover:border-amber-100/60 hover:shadow-default"
        >
          <h2 class="text-2xl font-semibold text-amber-100">{card.title}</h2>
          <p class="mt-3 flex-grow text-amber-50/80">{card.description}</p>
          <span class="mt-5 inline-flex items-center gap-1 text-amber-200">
            {card.cta}
            <span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </section>
  </div>
</SiteLayout>
